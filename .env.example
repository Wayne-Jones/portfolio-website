# CMS selection (optional):
#   'ghost'   - use the Ghost Content API in dev (requires the vars below)
#   'snapshot' - always use the committed snapshot (src/content/data/)
#   unset     - mock in dev, snapshot in production builds (default)
VITE_CMS=

# Ghost Content API configuration (only required when VITE_CMS=ghost)
VITE_GHOST_URL=
VITE_GHOST_CONTENT_API_KEY=

# Snapshot source for `pnpm snapshot` / `pnpm build` (optional):
#   unset    - fetch from Ghost when both vars above are set,
#              otherwise keep the committed snapshot
#   'ghost'  - require Ghost credentials and fetch
#   'mock'   - write the mock fixtures (explicit fixture work)
#   'snapshot' - keep the committed snapshot
SNAPSHOT_SOURCE=

# Cloudinary cloud name (optional).
# When set, post images served from
# `res.cloudinary.com/<VITE_CLOUDINARY_CLOUD_NAME>/image/upload/...` get a
# responsive `srcset` (400/800/1200/1600px). When unset, images render with
# their original URL.
VITE_CLOUDINARY_CLOUD_NAME=

# Absolute site URL used in sitemap.xml and rss.xml (optional).
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then https://waynejones.dev.
SITE_URL=
