# CMS selection (optional):
#   'ghost'   - use the Ghost Content API in dev (requires the vars below)
#   'snapshot' - always use the committed snapshot (src/content/data/)
#   unset     - mock in dev, snapshot in production builds (default)
VITE_CMS=

# Ghost Content API configuration (only required when VITE_CMS=ghost)
VITE_GHOST_URL=
VITE_GHOST_CONTENT_API_KEY=